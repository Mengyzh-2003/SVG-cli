{
  "name": "svg-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "cli": "tsx src/main.ts",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.test.json",
    "build": "tsc",
    "pretest": "npm run build",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "saxes": "^6.0.0",
    "xmlchars": "^2.2.0"
  }
}
